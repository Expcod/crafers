<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Retseptdagi operatsiyalar ro'yxatiga dona narxi ustuni -->
    <record id="view_routing_workcenter_list_ishbay" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.list.ishbay</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='workcenter_id']" position="after">
                <field name="ishbay_narx" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_routing_workcenter_form_ishbay" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.form.ishbay</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='workcenter_id']" position="after">
                <field name="ishbay_narx"/>
            </xpath>
        </field>
    </record>

</odoo>
